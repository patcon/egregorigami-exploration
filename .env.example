# Copy to .env (gitignored) and fill in.
#
# Read by `wrangler dev` / `pnpm cf:dev` as Worker secrets. Not exposed to the
# browser bundle (Vite only exposes VITE_-prefixed vars).
#
# For the deployed Worker, set it once with:
#   pnpm wrangler secret put SUPADATA_API_KEY

# Supadata API key (https://supadata.ai) — used by the Cloudflare Worker to fetch
# transcripts, since YouTube bot-blocks Cloudflare IPs. Optional for `pnpm dev`,
# which fetches from YouTube directly. Each uncached fetch costs one credit.
SUPADATA_API_KEY=

# --- Build flags (normally set by `pnpm build:cf`, not here) ---
# VITE_BASE=/                  # base path; defaults to /egregorigami-exploration/ for GitHub Pages
# VITE_TRANSCRIPT_API=true     # enable in-app transcript fetching in production builds

# --- GitHub Actions secrets (repo Settings → Secrets → Actions, not this file) ---
# CLOUDFLARE_API_TOKEN         # "Edit Cloudflare Workers" template token
# CLOUDFLARE_ACCOUNT_ID        # from `pnpm wrangler whoami`
