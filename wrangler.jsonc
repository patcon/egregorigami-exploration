{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "egregorigami-exploration",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Transcript cache keyed by video ID ("egregorigami-exploration-transcripts").
  // "remote": true makes `wrangler dev` read/write the production KV namespace
  // (shared cache, fewer Supadata credits) instead of a local simulated one.
  "kv_namespaces": [{ "binding": "TRANSCRIPTS", "id": "8c741b11761247d08d7ef6071cdb5eae", "remote": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
